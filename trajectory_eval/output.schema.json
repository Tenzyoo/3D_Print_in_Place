{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string"
    },
    "dimensions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4"
            ]
          },
          "label": {
            "type": "string",
            "enum": [
              "verified",
              "attempted_insufficient",
              "no_evidence",
              "unknown"
            ]
          },
          "method": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "mixed",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "action",
                    "result",
                    "claim",
                    "version",
                    "context"
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "event_id",
                "role",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "final_version": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "event_id": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "action",
                        "result",
                        "claim",
                        "version",
                        "context"
                      ]
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "event_id",
                    "role",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "status",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          },
          "self_check": {
            "type": "object",
            "properties": {
              "verdict": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "mixed",
                  "none",
                  "unknown"
                ]
              },
              "target": {
                "type": "string",
                "enum": [
                  "final",
                  "intermediate",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "event_id": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "action",
                        "result",
                        "claim",
                        "version",
                        "context"
                      ]
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "event_id",
                    "role",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "verdict",
              "target",
              "evidence"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "dimension",
          "label",
          "method",
          "outcome",
          "evidence",
          "final_version",
          "self_check",
          "reason",
          "limitations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "dimensions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
