// =====================================================================
//  Print-in-place articulated snake (1 head + 5 body segments)
//  OpenSCAD 2021.01, units: mm
//
//  Layout (neutral, straight pose):
//    head points to +X, tail to -X, Z is up, model sits on the bed (z=0).
//    5 revolute joints, all rotating about +Z, at x = J(i), y = 0.
//
//  Joint principle ("socket + double-cone pin", printed in place):
//    * the FRONT part of each joint carries a vertical SOCKET ring at its
//      rear end; the ring has a cylindrical bore with a 45-deg double-cone
//      groove in the middle, and a slot that opens towards the rear.
//    * the REAR part carries a vertical PIN with a 45-deg double-cone
//      collar (bulge), connected to its body by a NECK through the slot.
//    * the collar sits inside the groove -> the parts are locked along the
//      joint axis (Z) in both directions; the bore/pin radial gap is
//      `gap_pin` (0.5 mm).  All down-facing surfaces inside the joint are
//      45-deg cones -> no support needed.
//    * the slot and all body-to-body faces are generated by sweeping the
//      rear part through +/- sweep_ang and offsetting by `gap_body`, so
//      clearance is guaranteed over the whole motion range; the neck
//      hitting the slot wall is the hard end stop (~ +/-33 deg).
//
//  Usage:
//    openscad -o model.stl model.scad                 (all 6 parts)
//    openscad -D part=N -o parts/parts_N.stl model.scad   (N = 1..6,
//                                1 = head, 2..6 = body 1..5)
// =====================================================================

/* ---------------- user parameters ---------------- */
part      = 0;      // 0 = whole model, 1..6 = single part
H         = 14;     // segment height (Z)
pitch     = 22;     // distance between neighbouring joints (X)
n_joint   = 5;

// joint / pin
rp        = 4.0;    // pin radius
bulge     = 2.0;    // radial height of the 45-deg collar on the pin
z_c0      = 3.5;    // z where the lower collar cone starts
z_c1      = 8.5;    // z where the upper collar cone starts (cyl. part z_c0+bulge..z_c1)
gap_pin   = 0.5;    // single-side radial clearance pin <-> bore (0.4..0.6)
Ro        = 10.0;   // socket ring outer radius
neck_w    = 4.0;    // neck width
gap_body  = 0.6;    // clearance of all other moving faces (slot, body-body)
sweep_ang = 30;     // clearance is generated for +/- this angle
sweep_step= 2;      // angular step of the clearance sweep

// segment radii (plan view), index 0 = head ... 5 = tail
seg_r     = [13, 12.5, 12, 11.5, 11, 10.5];

// cosmetic / printing
chamfer_top = 0.8;  // stepped top chamfer (steps = layer height)
foot        = 0.2;  // first-layer inset (elephant foot relief, 0.2 step = 45 deg)
layer       = 0.2;
pin_chamf   = 0.4;  // pin bottom chamfer
eye_r       = 2.2;
eye_d       = 1.6;

$fn = 72;

/* ---------------- derived ---------------- */
function J(i) = -(i-1)*pitch;          // x of joint i (i = 1..5)
// segment k (0 = head, 1..5 bodies): front joint = k (k>=1), rear joint = k+1 (k<=4)

/* ---------------- 2D plan shapes ---------------- */
// raw outline of segment k (before any joint cuts)
module raw_outline(k) {
    if (k == 0) {                       // head
        hull() {
            translate([J(1), 0]) circle(r = Ro);
            translate([J(1) + 11, 0]) circle(r = seg_r[0]);
            translate([J(1) + 25, 0]) circle(r = 8.5);
        }
    } else if (k == 5) {                // tail
        hull() {
            translate([J(5) - 11, 0]) circle(r = seg_r[5]);
            translate([J(5) - 32, 0]) circle(r = 1.6);
        }
    } else {                            // body 1..4
        hull() {
            translate([J(k) - pitch/2, 0]) circle(r = seg_r[k]);
            translate([J(k+1), 0]) circle(r = Ro);
        }
    }
}

// neck of segment k (k>=1): from the pin centre to its body, in local coords
module neck_local() {
    translate([-(Ro + gap_body + 2.5), -neck_w/2]) square([Ro + gap_body + 2.5, neck_w]);
}

// the part of segment k (k>=1) that moves around its front joint,
// used to cut the clearance into the front neighbour
module mover_outline(k) {
    difference() {
        raw_outline(k);
        translate([J(k), 0]) circle(r = Ro + gap_body);
    }
    translate([J(k), 0]) neck_local();
}

// body outline of segment k without the neck (k>=1 front cut applied)
module body_outline(k) {
    difference() {
        union() {
            raw_outline(k);
            if (k <= 4) translate([J(k+1), 0]) circle(r = Ro);   // socket ring
        }
        if (k >= 1) translate([J(k), 0]) circle(r = Ro + gap_body);
        if (k <= 4) clearance_cut(k+1);
    }
}

// swept clearance region of segment (k) around its front joint k
module clearance_cut(k) {
    offset(r = gap_body)
        union()
            for (a = [-sweep_ang : sweep_step : sweep_ang])
                translate([J(k), 0]) rotate(a) translate([-J(k), 0])
                    mover_outline(k);
}

/* ---------------- 3D joint elements ---------------- */
// r-z half-profile of the pin (without chamfers)
module pin_profile_raw(zmin = 0, zmax = H) {
    polygon([
        [0, zmin], [rp, zmin], [rp, z_c0], [rp + bulge, z_c0 + bulge],
        [rp + bulge, z_c1], [rp, z_c1 + bulge], [rp, zmax], [0, zmax]
    ]);
}

module pin3d() {
    rotate_extrude($fn = 96)
        polygon([
            [0, 0], [rp - pin_chamf, 0], [rp, pin_chamf], [rp, z_c0],
            [rp + bulge, z_c0 + bulge], [rp + bulge, z_c1],
            [rp, z_c1 + bulge], [rp, H - pin_chamf],
            [rp - pin_chamf, H], [0, H]
        ]);
}

// bore + groove = pin profile offset by the radial clearance
module cavity3d() {
    rotate_extrude($fn = 96)
        intersection() {
            offset(r = gap_pin, $fn = 32) pin_profile_raw(-2, H + 2);
            translate([0, -1]) square([50, H + 2]);
        }
}

/* ---------------- extrusion with stepped chamfers ---------------- */
module stepped_extrude() {
    nt = round(chamfer_top / layer);
    // first layer, inset for elephant-foot relief
    linear_extrude(layer) offset(delta = -foot) children();
    // main body
    translate([0, 0, layer]) linear_extrude(H - layer - nt*layer) children();
    // top chamfer, one step per layer
    for (s = [1 : nt])
        translate([0, 0, H - (nt - s + 1)*layer])
            linear_extrude(layer) offset(delta = -s*layer) children();
}

/* ---------------- segments ---------------- */
module segment(k) {
    difference() {
        union() {
            stepped_extrude() body_outline(k);
            if (k >= 1) {
                // neck (full height, no chamfer -> stronger)
                translate([J(k), 0, 0]) linear_extrude(H) neck_local();
                translate([J(k), 0, 0]) pin3d();
            }
        }
        if (k <= 4) translate([J(k+1), 0, 0]) cavity3d();
        if (k == 0)                      // eyes (top recesses, no overhang)
            for (s = [-1, 1])
                translate([J(1) + 21, s*6.5, H - eye_d]) cylinder(r = eye_r, h = eye_d + 1);
    }
}

if (part == 0) for (k = [0 : 5]) segment(k);
else segment(part - 1);
